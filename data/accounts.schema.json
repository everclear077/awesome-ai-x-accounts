{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome AI X Accounts — public profile snapshots (v3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_locale",
    "categories",
    "accounts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "default_locale": {
      "type": "string",
      "enum": [
        "en"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handle",
          "name",
          "url",
          "category",
          "bio",
          "followers_count",
          "observed_at",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{1,25}$"
          },
          "handle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,15}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "x-verbatim": true
          },
          "url": {
            "type": "string",
            "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "bio": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "x-verbatim": true
          },
          "followers_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
